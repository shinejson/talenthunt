# ==============================================================================
# StageLight Ghana Talent Hunt — Production Environment Configuration (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & FLASK ENVIRONMENT
# ------------------------------------------------------------------------------
FLASK_ENV=production
FLASK_DEBUG=false
PORT=5050
PLATFORM_NAME=StageLight
PLATFORM_CURRENCY=GHS
DEFAULT_TIMEZONE=Africa/Accra

# CRITICAL: Generate a cryptographically secure random 64-char key in production:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-cryptographically-secure-random-string-in-production

# Web concurrency (number of Gunicorn worker processes)
WEB_CONCURRENCY=4
PYTHON_GETHREAD_THREADS=4

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (POSTGRESQL RECOMMENDED FOR PRODUCTION)
# ------------------------------------------------------------------------------
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://stagelight_user:your_secure_password@localhost:5432/stagelight_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
AUTO_SEED_DEMO=false

# ------------------------------------------------------------------------------
# 3. DISTRIBUTED RATE LIMITING & CACHING (REDIS)
# ------------------------------------------------------------------------------
# Redis instance for multi-worker distributed rate limiting
RATELIMIT_ENABLED=true
RATELIMIT_STORAGE_URI=redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 4. PAYMENT GATEWAY (PAYSTACK GHANA / MOBILE MONEY & CARDS)
# ------------------------------------------------------------------------------
# Options: 'paystack' (production) or 'mock' (local/testing)
PAYMENT_PROVIDER=paystack

# Paystack API Keys (obtain from Paystack Dashboard -> Settings -> API Keys)
# Live secret key starts with: sk_live_...
PAYSTACK_SECRET_KEY=sk_live_your_paystack_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_live_your_paystack_public_key_here
PAYSTACK_BASE_URL=https://api.paystack.co

# Webhook signature secret (matches webhook signing key configured in Paystack dashboard)
PAYMENT_WEBHOOK_SECRET=your_configured_paystack_webhook_signing_secret

# ------------------------------------------------------------------------------
# 5. SECURITY & COOKIES
# ------------------------------------------------------------------------------
# Set to 'true' in production (requires HTTPS)
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax

# Frontend domain for CORS policy (restrict strictly to your production domain)
FRONTEND_ORIGIN=https://stagelight.com.gh

# JWT Token Lifetime (in hours)
TOKEN_EXPIRE_HOURS=72

# ------------------------------------------------------------------------------
# 6. FILE STORAGE & AUDITION MEDIA UPLOADS
# ------------------------------------------------------------------------------
UPLOAD_FOLDER=/app/backend/uploads
MAX_UPLOAD_BYTES=41943040 # 40 MB in bytes

# (Optional) AWS S3 / Cloudflare R2 Object Storage for Video/Audio Assets
# S3_BUCKET_NAME=stagelight-media-production
# S3_REGION=eu-west-1
# S3_ACCESS_KEY_ID=your_access_key_id
# S3_SECRET_ACCESS_KEY=your_secret_access_key
# S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com

# ------------------------------------------------------------------------------
# 7. SMS GATEWAY INTEGRATION (FOR GHANA MOBILE MONEY VOTER RECEIPTS & OTP)
# ------------------------------------------------------------------------------
# Provider options: 'arkesel', 'hubtel', 'mnotify', 'twilio'
SMS_PROVIDER=arkesel
SMS_API_KEY=your_sms_provider_api_key
SMS_SENDER_ID=StageLight

# ------------------------------------------------------------------------------
# 8. TRANSACTIONAL EMAIL (FOR PASSWORD RESETS & SYSTEM TICKETS)
# ------------------------------------------------------------------------------
# Provider: SMTP, SendGrid, or Postmark
MAIL_SERVER=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=apikey
MAIL_PASSWORD=your_sendgrid_api_key
MAIL_DEFAULT_SENDER="StageLight Ghana <noreply@stagelight.com.gh>"

# ------------------------------------------------------------------------------
# 9. MONITORING, ERROR TRACKING & OBSERVABILITY
# ------------------------------------------------------------------------------
# Sentry DSN for automatic crash reporting & performance monitoring
# SENTRY_DSN=https://your_sentry_key@o000000.ingest.sentry.io/0000000
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.2
